{
  "openapi": "3.0.3",
  "info": {
    "title": "WyAPI-Golang",
    "version": "2.0.0",
    "description": "网易云音乐解析与下载 API"
  },
  "servers": [
    { "url": "/" }
  ],
  "components": {
    "securitySchemes": {
      "ApiToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Token"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer" },
          "status": { "type": "integer" },
          "success": { "type": "boolean" },
          "msg": { "type": "string" },
          "message": { "type": "string" },
          "data": { "type": "object" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "健康检查",
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/info": {
      "get": {
        "summary": "API信息",
        "security": [{ "ApiToken": [] }, { "BearerAuth": [] }],
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/key": {
      "post": {
        "summary": "新版兼容加密会话",
        "description": "返回 keyId、keyToken 与 base64 AES-GCM key；新版兼容接口也支持直接明文 JSON。",
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/music/url": {
      "post": {
        "summary": "获取歌曲播放链接",
        "security": [{ "ApiToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "level": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/music/detail": {
      "post": {
        "summary": "获取歌曲详情",
        "security": [{ "ApiToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/music/lyric": {
      "post": {
        "summary": "获取歌词",
        "security": [{ "ApiToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/music/playlist": {
      "post": {
        "summary": "获取歌单详情",
        "security": [{ "ApiToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/music/album": {
      "post": {
        "summary": "获取专辑详情",
        "security": [{ "ApiToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/search": {
      "post": {
        "summary": "新版兼容搜索",
        "description": "兼容 nextmusic 风格。请求可使用 {keyword, type, limit, offset}，也可使用 {keyId, keyToken, data} 加密包。",
        "security": [{ "ApiToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "keyword": { "type": "string" },
                  "limit": { "type": "integer" },
                  "offset": { "type": "integer" },
                  "keyId": { "type": "string" },
                  "keyToken": { "type": "string" },
                  "data": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/getSongInfo": {
      "post": {
        "summary": "新版兼容歌曲详情",
        "security": [{ "ApiToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" }, "url": { "type": "string" }, "keyId": { "type": "string" }, "keyToken": { "type": "string" }, "data": { "type": "string" } } } } }
        },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/getSongUrl": {
      "post": {
        "summary": "新版兼容歌曲播放链接",
        "security": [{ "ApiToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" }, "level": { "type": "string" }, "quality": { "type": "string" }, "keyId": { "type": "string" }, "keyToken": { "type": "string" }, "data": { "type": "string" } } } } }
        },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/getSongLyric": {
      "post": {
        "summary": "新版兼容歌词",
        "security": [{ "ApiToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" }, "keyId": { "type": "string" }, "keyToken": { "type": "string" }, "data": { "type": "string" } } } } }
        },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/getAlbum": {
      "post": {
        "summary": "新版兼容专辑详情",
        "security": [{ "ApiToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" }, "url": { "type": "string" }, "keyId": { "type": "string" }, "keyToken": { "type": "string" }, "data": { "type": "string" } } } } }
        },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/playlist_trackall": {
      "post": {
        "summary": "新版兼容歌单全部歌曲",
        "security": [{ "ApiToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" }, "limit": { "type": "integer" }, "offset": { "type": "integer" }, "keyId": { "type": "string" }, "keyToken": { "type": "string" }, "data": { "type": "string" } } } } }
        },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/toplist": {
      "post": {
        "summary": "新版兼容榜单列表",
        "security": [{ "ApiToken": [] }, { "BearerAuth": [] }],
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/api/song/wiki": {
      "post": {
        "summary": "新版兼容歌曲发行信息",
        "security": [{ "ApiToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" }, "keyId": { "type": "string" }, "keyToken": { "type": "string" }, "data": { "type": "string" } } } } }
        },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/search": {
      "post": {
        "summary": "搜索音乐",
        "security": [{ "ApiToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "keyword": { "type": "string" },
                  "limit": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } }
        }
      }
    },
    "/download": {
      "post": {
        "summary": "下载音乐",
        "security": [{ "ApiToken": [] }, { "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "quality": { "type": "string" },
                  "format": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "ok" }
        }
      }
    }
  }
}
